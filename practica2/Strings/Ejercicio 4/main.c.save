#include <stdio.h>
#include <stdlib.h>
#
int length(char word []);

int main()
{
    char word [30] = {"Hello world!"};
    int pepe = length(word);
    printf("%d", pepe);
    return 0;
}

int length(char word[])
{
    int i = 0;
    while (word[i] != '/0')
        {
            i++;
        }
    return i;
}
